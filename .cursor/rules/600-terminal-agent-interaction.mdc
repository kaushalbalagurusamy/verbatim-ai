## Core Terminal Interaction Rules

### Command Execution Protocol
@execution_rules [
  {
    "id": "single_command",
    "rule": "Execute ONE command at a time",
    "severity": "error",
    "example": "npm install (wait for completion) THEN npm run dev"
  },
  {
    "id": "wait_for_completion",
    "rule": "ALWAYS wait for command output before proceeding",
    "severity": "error",
    "pattern": "Execute → Wait → Observe → Decide"
  },
  {
    "id": "explicit_confirmation",
    "rule": "Confirm command completion by checking exit status or output",
    "severity": "error"
  }
]

### Shell State Management
@shell_state [
  {
    "id": "track_working_directory",
    "rule": "Always track current working directory (pwd)",
    "command": "pwd",
    "frequency": "After cd commands and before file operations"
  },
  {
    "id": "environment_awareness",
    "rule": "Check and track environment variables when relevant",
    "commands": ["echo $PATH", "which [command]", "env | grep [var]"]
  },
  {
    "id": "shell_context",
    "rule": "Remember shell type and adjust commands accordingly",
    "detection": "echo $SHELL or echo $0"
  }
]

## ReAct Pattern Implementation

### Thought-Action-Observation Loop
@react_pattern {
  "description": "Structured approach to terminal interactions",
  "steps": [
    {
      "phase": "THOUGHT",
      "action": "Analyze what needs to be done",
      "example": "I need to install dependencies before running the server"
    },
    {
      "phase": "ACTION",
      "action": "Execute single, atomic command",
      "example": "npm install"
    },
    {
      "phase": "OBSERVATION",
      "action": "Wait and analyze complete output",
      "example": "Check for 'added X packages' or error messages"
    },
    {
      "phase": "REFLECTION",
      "action": "Determine next step based on observation",
      "example": "Installation successful, now can run dev server"
    }
  ]
}

### Terminal Output Interpretation
@output_interpretation [
  {
    "id": "success_indicators",
    "patterns": [
      "Process exit code 0",
      "No error messages in stderr",
      "Expected output patterns (e.g., 'Server running on port')",
      "Creation of expected files/directories"
    ]
  },
  {
    "id": "partial_output_handling",
    "rule": "Don't assume command failed if output is truncated",
    "action": "Wait for command prompt to return"
  },
  {
    "id": "async_process_handling",
    "rule": "Recognize when processes run in background",
    "indicators": ["&", "nohup", "daemon", "service started"]
  }
]

## Platform-Specific Considerations

### Cross-Platform Command Guidelines
@platform_commands [
  {
    "id": "os_detection",
    "commands": {
      "windows": "echo %OS%",
      "unix": "uname -s",
      "general": "Check IDE or system information"
    }
  },
  {
    "id": "command_alternatives",
    "mappings": [
      {
        "unix": "ls -la",
        "windows": "dir /a",
        "purpose": "List all files including hidden"
      },
      {
        "unix": "rm -rf",
        "windows": "rmdir /s /q",
        "purpose": "Remove directory recursively"
      },
      {
        "unix": "cat file.txt",
        "windows": "type file.txt",
        "purpose": "Display file contents"
      }
    ]
  },
  {
    "id": "path_separators",
    "rule": "Use forward slashes (/) or Path.join() for cross-platform compatibility"
  }
]

### Windows PowerShell Specific
@powershell_rules [
  {
    "id": "no_chaining",
    "rule": "Avoid && operator, use ; or separate commands",
    "severity": "error"
  },
  {
    "id": "execution_policy",
    "check": "Get-ExecutionPolicy",
    "fix": "Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned"
  },
  {
    "id": "script_format",
    "rule": "Use .ps1 scripts for complex operations",
    "location": "@scripts/ directory"
  }
]

## Error Recovery Strategies

### Command Failure Handling
@error_recovery [
  {
    "id": "permission_errors",
    "detection": "Permission denied, Access denied, EACCES",
    "recovery": [
      "Check file ownership: ls -la (unix) or icacls (windows)",
      "Try with elevated permissions if appropriate",
      "Verify current user has necessary access"
    ]
  },
  {
    "id": "command_not_found",
    "detection": "command not found, not recognized",
    "recovery": [
      "Check if tool is installed: which/where command",
      "Verify PATH includes tool location",
      "Install missing tool if needed"
    ]
  },
  {
    "id": "port_conflicts",
    "detection": "EADDRINUSE, port already in use",
    "recovery": [
      "Find process: lsof -i :PORT (unix) or netstat -ano | findstr :PORT",
      "Kill process or use different port",
      "Check for zombie processes"
    ]
  }
]

## Long-Running Process Management

### Background Process Handling
@background_processes [
  {
    "id": "server_processes",
    "examples": ["npm run dev", "python manage.py runserver", "docker-compose up"],
    "handling": [
      "Recognize these run indefinitely",
      "Don't wait for completion",
      "Monitor startup messages for readiness",
      "Use separate terminal or background flag (&)"
    ]
  },
  {
    "id": "process_monitoring",
    "commands": [
      "ps aux | grep [process]",
      "lsof -i :PORT",
      "tail -f logfile.log"
    ]
  },
  {
    "id": "graceful_shutdown",
    "methods": [
