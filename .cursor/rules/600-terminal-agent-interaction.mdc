## Best Practices Implementation

### Command Composition
@command_best_practices [
  {
    "id": "atomic_operations",
    "rule": "Each command should do one thing well",
    "example": "mkdir -p dir && cd dir → mkdir -p dir THEN cd dir"
  },
  {
    "id": "idempotent_commands",
    "rule": "Prefer commands that can be run multiple times safely",
    "examples": ["mkdir -p", "npm ci instead of npm install", "cp -n"]
  },
  {
    "id": "verbose_flags",
    "rule": "Use verbose flags for better observability",
    "examples": ["npm install --verbose", "cp -v", "rm -v"]
  }
]

### Environment Isolation
@environment_isolation [
  {
    "id": "virtual_environments",
    "rule": "Use isolated environments for different projects",
    "tools": ["python venv", "nvm", "rbenv", "docker"]
  },
  {
    "id": "dependency_conflicts",
    "rule": "Check for conflicts before installing global packages",
    "commands": ["npm list -g", "pip list", "gem list"]
  }
]

