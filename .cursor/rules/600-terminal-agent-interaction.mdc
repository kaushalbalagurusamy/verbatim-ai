## Core Terminal Interaction Rules

### Command Execution Protocol

@execution_rules [
{
"id": "single_command",
"rule": "Execute ONE command at a time",
"severity": "error",
"example": "npm install (wait for completion) THEN npm run dev"
},
{
"id": "wait_with_timeout",
"rule": "Wait for output with reasonable timeout, don't wait indefinitely",
"severity": "error",
"pattern": "Execute → Wait (max 5s) → Observe → Continue"
},
{
"id": "explicit_confirmation",
"rule": "Confirm completion by output patterns, not endless waiting",
"severity": "error"
}
]

### Shell State Management

@shell_state [
{
"id": "track_working_directory",
"rule": "Always track current working directory (pwd)",
"command": "pwd",
"frequency": "After cd commands and before file operations"
},
{
"id": "environment_awareness",
"rule": "Check and track environment variables when relevant",
"commands": ["echo $PATH", "which [command]", "env | grep [var]"]
},
{
"id": "shell_context",
"rule": "Remember shell type and adjust commands accordingly",
"detection": "echo $SHELL or echo $0"
}
]

## ReAct Pattern Implementation

### Enhanced Thought-Action-Observation Loop

@react_pattern {
"description": "Structured approach with timeout awareness",
"steps": [
{
"phase": "THOUGHT",
"action": "Analyze what needs to be done and potential blocking points",
"example": "I need to start dev server which runs indefinitely"
},
{
"phase": "ACTION",
"action": "Execute with appropriate timeout or background flag",
"example": "npm run dev & or timeout 5s npm run dev"
},
{
"phase": "OBSERVATION",
"action": "Wait for success indicators, not completion",
"example": "Check for 'Server running on port' within 5 seconds"
},
{
"phase": "REFLECTION",
"action": "Continue if successful, don't wait for impossible completion",
"example": "Server started, continue with next task"
}
]
}

