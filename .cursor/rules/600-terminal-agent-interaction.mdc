    ]
  }
]

## Safety and Security Protocols

### Dangerous Command Prevention
@safety_rules [
  {
    "id": "destructive_commands",
    "restricted": ["rm -rf /", "format c:", ":(){ :|:& };:", "dd if=/dev/zero"],
    "rule": "Always confirm before destructive operations",
    "severity": "error"
  },
  {
    "id": "credential_handling",
    "rule": "Never echo or log sensitive credentials",
    "safe_practices": [
      "Use environment variables",
      "Read from .env files",
      "Use secret management tools"
    ]
  },
  {
    "id": "script_validation",
    "rule": "Review scripts before execution",
    "checks": ["cat script.sh", "Verify no malicious commands", "Check permissions"]
  }
]

