{
  "name": "verbatim-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch server/src/index.ts",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "playwright test e2e/performance-budget.spec.ts",
    "test:lighthouse": "lhci autorun",
    "test:lighthouse:local": "npm run build && lhci autorun --collect.startServerCommand='npm run preview'",
    "perf:monitor": "vite --mode development --open /test-performance"
  },
